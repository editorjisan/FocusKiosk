<?xml version="1.0" encoding="utf-8"?>
<!--
    device_admin_receiver.xml
    ─────────────────────────
    Declares the DevicePolicyManager capability groups this admin uses.
    As Device Owner, most privileged APIs (setApplicationHidden,
    setPackagesSuspended, addUserRestriction, silent PackageInstaller)
    are available implicitly without needing individual <uses-policies>
    entries. We enumerate them anyway for clarity and documentation.
-->
<device-admin>
    <uses-policies>
        <!-- DevicePolicyManager.lockNow() -->
        <force-lock />
        <!-- DevicePolicyManager.resetPassword() -->
        <reset-password />
        <!-- DevicePolicyManager.setPasswordQuality() -->
        <limit-password />
        <!-- DevicePolicyManager.wipeData() -->
        <wipe-data />
        <!-- DevicePolicyManager.setKeyguardDisabledFeatures() -->
        <disable-keyguard-features />
        <!-- DevicePolicyManager.setUninstallBlocked() -->
        <block-uninstall />
    </uses-policies>
</device-admin>
