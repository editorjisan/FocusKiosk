<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_setup_wizard.xml
    Hierarchy: ConstraintLayout root
      - Header section (title + subtitle) pinned to top
      - RecyclerView with layout_height=0dp between header and controls
      - Controls panel pinned to bottom (duration picker + toggles + button)
    This eliminates the nested-ScrollView problem entirely.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- ── Header ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerTitleLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Kiosk Setup"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="v1.0.7 (Build 8)"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#1B5E20"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- ── Dedicated OTA Update Section ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/otaUpdateCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#16213E"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvUpdateLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GitHub Silent OTA"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdate"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="CHECK &amp; INSTALL OTA"
                android:textSize="11sp"
                android:backgroundTint="#1976D2" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarUpdate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap above to check GitHub for OTA updates"
            android:textColor="#90CAF9"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Adult Media Purge Card -->
    <LinearLayout
        android:id="@+id/adultMediaCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1B2E"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/otaUpdateCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMediaPurgeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="18+ Adult Media Purge"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPurgeMediaNow"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="PURGE NOW"
                android:textSize="11sp"
                android:backgroundTint="#D32F2F" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMediaPurgeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Continuous auto-sentinel active. Tap to deep clean storage now."
            android:textColor="#FFCDD2"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantAllFiles"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:text="GRANT ALL FILES ACCESS (SETTINGS)"
            android:textSize="10sp"
            android:textColor="#FF8A80"
            app:strokeColor="#FF8A80"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvWizardSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select apps to keep accessible. All others will be hidden and suspended."
        android:textColor="#AAFFFFFF"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/adultMediaCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvWizardSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── App list (fills remaining space between header and controls) ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectApps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/dividerBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/dividerBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Controls panel pinned to bottom ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="#1A1A2E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Modern Digital Timer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCK DURATION"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvDurationPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 min"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Digital Time Display & Stepper Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp">

                <!-- Days Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvDisplayDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAYS"
                        android:textColor="#80FFFFFF"
                        android:textSize="9sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <Button
                            android:id="@+id/btnMinusDay"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="-"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnPlusDay"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="#55FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Hours Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvDisplayHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOURS"
                        android:textColor="#80FFFFFF"
                        android:textSize="9sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <Button
                            android:id="@+id/btnMinusHour"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="-"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnPlusHour"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="#55FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Minutes Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvDisplayMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:textColor="#00E5FF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MINUTES"
                        android:textColor="#80FFFFFF"
                        android:textSize="9sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <Button
                            android:id="@+id/btnMinusMinute"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="-"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnPlusMinute"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="#00E5FF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Unlock summary line -->
            <TextView
                android:id="@+id/tvUnlockTimestampPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unlocks at: 12:00 AM"
                android:textColor="#90CAF9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick Presets Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset1m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="1 min"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    app:strokeColor="#00E5FF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset2m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="2 min"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset5m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="5 min"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset15m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="15 min"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset30m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="30 min"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset1h"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="1 hr"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset2h"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="2 hr"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset4h"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="4 hr"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset1d"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="1 day"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset7d"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="7 days"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPreset30d"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="30 days"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:strokeColor="#44FFFFFF" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Factory reset toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFactoryReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block factory reset during lock"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"
            android:checked="true" />

        <!-- USB debugging toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchUsbDebugging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable USB debugging during lock"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:checked="true" />

        <!-- Activate button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivateLock"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ACTIVATE FOCUS LOCK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#E53935" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
