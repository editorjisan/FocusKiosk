<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_setup_wizard.xml
    Hierarchy: ConstraintLayout root
      - Header section (title + subtitle) pinned to top
      - RecyclerView with layout_height=0dp between header and controls
      - Controls panel pinned to bottom (duration picker + toggles + button)
    This eliminates the nested-ScrollView problem entirely.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- ── Header ───────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvWizardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Focus Kiosk Setup"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCheckUpdate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckUpdate"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check Update"
        android:textColor="#42A5F5"
        android:textSize="12sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tvWizardTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvWizardTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvWizardSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select apps to keep accessible. All others will be hidden and suspended."
        android:textColor="#AAFFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvWizardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvWizardSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── App list (fills remaining space between header and controls) ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectApps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/dividerBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/dividerBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Controls panel pinned to bottom ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1A1A2E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Duration label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lock Duration"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Number pickers row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <!-- Years -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <NumberPicker
                    android:id="@+id/pickerYears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Years"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Days -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <NumberPicker
                    android:id="@+id/pickerDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Days"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Hours -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <NumberPicker
                    android:id="@+id/pickerHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hours"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Minutes -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <NumberPicker
                    android:id="@+id/pickerMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minutes"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Duration preview -->
        <TextView
            android:id="@+id/tvDurationPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- Factory reset toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFactoryReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block factory reset during lock"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"
            android:checked="true" />

        <!-- USB debugging toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchUsbDebugging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable USB debugging during lock"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            android:checked="true" />

        <!-- Activate button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivateLock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ACTIVATE FOCUS LOCK"
            android:textSize="14sp"
            android:backgroundTint="#E53935" />

        <!-- Emergency Restore button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergencyRestore"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="EMERGENCY RESTORE APPS"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            app:strokeColor="#4CAF50" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
