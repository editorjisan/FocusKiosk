<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <!-- Top Alarm Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivAlarmIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_shield"
            app:tint="#FF3B30"
            android:contentDescription="Alarm Icon"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAlarmClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06:30 AM"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKE UP! EXTREME ALARM"
            android:textColor="#FF3B30"
            android:textSize="18sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- PC Verification Instructions Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/instructionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2C2C2E"
        app:cardBackgroundColor="#1C1C1E"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖥️ PC Verification Required"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPortalInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Turn on your PC and open the Alarm Portal website.\n2. Log in with your ID &amp; Password.\n3. The 6-digit dismissal code will be displayed on screen.\n4. Enter the code below to stop the alarm."
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvUserIdHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Login ID: jisan"
                android:textColor="#007AFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Code Input Section -->
    <LinearLayout
        android:id="@+id/inputSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/instructionsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTER 6-DIGIT CODE"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAlarmCode"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_ios_search_bar"
            android:gravity="center"
            android:hint="• • • • • •"
            android:textColorHint="#48484A"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:inputType="number"
            android:maxLength="6"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/tvCodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invalid code. Please check your PC screen."
            android:textColor="#FF3B30"
            android:textSize="12sp"
            android:visibility="invisible"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Dismiss Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissAlarm"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="DISMISS ALARM"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:cornerRadius="16dp"
        android:backgroundTint="#FF3B30"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
